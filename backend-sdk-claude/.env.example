# ─────────────────────────────────────────────────────────────────────
# openclaw-mythos backend — variáveis de ambiente
# ─────────────────────────────────────────────────────────────────────
# Copie este arquivo pra .env e preencha os valores reais.
# Não commitar .env no git (já tá em .gitignore).

# ─── Servidor ───────────────────────────────────────────────────────
PORT=3456
NODE_ENV=production
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# ─── Auth bearer (REST autenticado) ─────────────────────────────────
# Header: "Authorization: Bearer $API_BEARER_SECRET"
# Use `openssl rand -hex 32` pra gerar.
API_BEARER_SECRET=

# Aliases legados — middleware ainda aceita estes nomes como fallback.
# Migre pra API_BEARER_SECRET; estas variaveis devem sair na proxima leva.
WEBHOOK_CRM_SECRET=
WEBHOOK_READAI_SECRET=

# ─── Claude Code SDK (claude-query.js) ──────────────────────────────
# Pin de versão do Node pra spawn do Claude CLI (evita Snap node, etc).
CLAUDE_NODE_BIN=

# Limite de processos Claude paralelos.
MAX_CLAUDE_PROCESSES=2

# Percentual de memória do sistema acima do qual o wrapper segura novas queries.
# Default 85. macOS sob pressão de RAM (>=95%) costuma travar — relaxe pra 95 ou 100.
MEMORY_THROTTLE_PERCENT=85

# ─── Task runner autônomo ───────────────────────────────────────────
# Intervalo (minutos) do ciclo de execução de tarefas pendentes.
# Default 0 (desligado — tarefas rodam só quando disparadas manualmente).
AUTONOMOUS_INTERVAL_MIN=
